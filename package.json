  },
  "scripts": {
    "init:env": "git config core.hooksPath .githooks && chmod -R +x ./.githooks",
    "build": "rslib build",
    "postbuild": "node scripts/generate-exports.mjs",
    "dev": "rslib build --watch",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "dev:all": "concurrently --names \"storybook,docs\" --prefix-colors \"magenta,cyan\" \"npm:storybook\" \"npm:docs:dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test-storybook": "test-storybook --url http://localhost:6006",
    "test-storybook:update": "test-storybook --url http://localhost:6006 -u",
    "test-storybook:ci": "concurrently -k -s first -n SB,TEST -c magenta,blue \"http-server storybook-static -p 6006 -s\" \"wait-on tcp:6006 && test-storybook --url http://localhost:6006 --ci\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:docs": "tsc -p docs/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
